{
  "manifest_version": 3,
  "name": "Suno Capture",
  "version": "1.0.0",
  "description": "Plays through your Suno library and saves each track as a clean audio file, using Chrome's tab audio capture — no download quota involved.",
  "permissions": ["tabCapture", "activeTab", "downloads", "storage", "offscreen"],
  "host_permissions": ["https://suno.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["title_utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Suno Capture"
  }
}
