{
  "manifest_version": 3,
  "name": "Suno Recorder",
  "version": "1.6.2",
  "description": "Record your Suno library track-by-track with Chrome tab audio — saves WAV files, lyrics, and cover art to your Chrome download folder.",
  "permissions": ["tabCapture", "activeTab", "downloads", "storage", "offscreen", "alarms", "tabs", "scripting", "debugger", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://suno.com/*", "https://cdn2.suno.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": [
        "title_utils.js",
        "recorded_log.js",
        "sidecar_utils.js",
        "dom_utils.js",
        "playbar_transport_picker.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Suno Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
